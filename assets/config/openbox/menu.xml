<?xml version="1.0" encoding="UTF-8"?>
<!-- The desktop's right-click menu. Every SLOPOS entry opens a native
     slopos-ui application; the terminal is the system's default one. -->
<openbox_menu xmlns="http://openbox.org/3.4/menu">
  <menu id="root-menu" label="SLOPOS">
    <item label="New Folder on Desktop">
      <action name="Execute"><command>sh -c 'mkdir -p "$HOME/Desktop/New Folder" &amp;&amp; exec slopos-files "$HOME/Desktop"'</command></action>
    </item>
    <separator/>
    <item label="Files">
      <action name="Execute"><command>slopos-files</command></action>
    </item>
    <item label="Calculator">
      <action name="Execute"><command>slopos-calculator</command></action>
    </item>
    <item label="Image Viewer">
      <action name="Execute"><command>slopos-image-viewer</command></action>
    </item>
    <item label="Media Player">
      <action name="Execute"><command>slopos-media</command></action>
    </item>
    <item label="Software">
      <action name="Execute"><command>slopos-software</command></action>
    </item>
    <item label="Terminal">
      <action name="Execute"><command>x-terminal-emulator</command></action>
    </item>
    <separator/>
    <item label="Change Desktop Picture…">
      <action name="Execute"><command>slopos-control-panels --desktop</command></action>
    </item>
    <item label="Date &amp; Time…">
      <action name="Execute"><command>slopos-control-panels --datetime</command></action>
    </item>
    <item label="Display…">
      <action name="Execute"><command>slopos-control-panels --display</command></action>
    </item>
    <item label="Sound…">
      <action name="Execute"><command>slopos-control-panels --sound</command></action>
    </item>
    <item label="Network…">
      <action name="Execute"><command>slopos-control-panels --network</command></action>
    </item>
    <item label="Control Panels">
      <action name="Execute"><command>slopos-control-panels</command></action>
    </item>
    <separator/>
    <item label="Search Applications (Super+Space)">
      <action name="Execute"><command>pkill -USR1 -x slopos-shell</command></action>
    </item>
    <item label="Next Workspace">
      <action name="DesktopNext"><wrap>yes</wrap></action>
    </item>
    <item label="Previous Workspace">
      <action name="DesktopPrevious"><wrap>yes</wrap></action>
    </item>
    <separator/>
    <item label="Log Out">
      <action name="Execute"><command>slopos-session --logout</command></action>
    </item>
  </menu>
</openbox_menu>
