# Maintainer: SLOPOS-I Contributors
pkgname=slopos-i-git
pkgver=0.1.0.r0
pkgrel=1
pkgdesc="SLOPOS-I X11 Platinum desktop environment"
arch=('x86_64' 'aarch64')
url="https://github.com/palaashatri/rust-slopos"
license=('MIT')
depends=(
  xorg-server openbox gtk3 dbus
  pcmanfm xfce4-terminal mousepad ristretto zathura zathura-pdf-mupdf mpv galculator
  networkmanager network-manager-applet pavucontrol pipewire pipewire-pulse wireplumber
  blueman upower xfce4-power-manager lxappearance arandr xorg-xrandr xorg-xsetroot
  xdotool wmctrl adwaita-icon-theme ttf-liberation ttf-dejavu
)
makedepends=(cargo pkgconf rust git openssl)
optdepends=('firefox: web browser' 'lightdm: graphical display manager')
provides=('slopos-i')
conflicts=('slopos-i')
source=('rust-slopos::git+https://github.com/palaashatri/rust-slopos.git#branch=pivot')
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/rust-slopos"
  printf '0.1.0.r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd "$srcdir/rust-slopos"
  export CARGO_TARGET_DIR="$srcdir/.cargo-target"
  cargo build --release --workspace --locked
}

package() {
  cd "$srcdir/rust-slopos"
  export CARGO_TARGET_DIR="$srcdir/.cargo-target"

  for binary in slopos-session slopos-shell slopos-catalogue slopos-settings; do
    install -Dm755 "$CARGO_TARGET_DIR/release/$binary" "$pkgdir/usr/bin/$binary"
  done
  install -Dm755 scripts/start-slopos-i "$pkgdir/usr/bin/start-slopos-i"

  install -Dm644 packaging/slopos-i.desktop "$pkgdir/usr/share/xsessions/slopos-i.desktop"
  install -Dm644 assets/config/openbox/rc.xml "$pkgdir/usr/share/slopos-i/openbox/rc.xml"
  install -Dm644 assets/config/openbox/menu.xml "$pkgdir/usr/share/slopos-i/openbox/menu.xml"
  install -Dm644 themes/slopos-openbox/openbox-3/themerc \
    "$pkgdir/usr/share/themes/slopos-openbox/openbox-3/themerc"
  install -Dm644 assets/config/gtk-3.0/gtk.css \
    "$pkgdir/usr/share/themes/slopos-gtk/gtk-3.0/gtk.css"
  install -Dm644 assets/config/gtk-3.0/settings.ini \
    "$pkgdir/usr/share/slopos-i/gtk-3.0/settings.ini"
  install -Dm644 assets/config/mimeapps.list "$pkgdir/usr/share/slopos-i/mimeapps.list"
  cp -a themes/platinum "$pkgdir/usr/share/slopos-i/themes/"

  install -Dm644 README.md "$pkgdir/usr/share/doc/slopos-i/README.md"
  install -Dm644 AGENTS.md "$pkgdir/usr/share/doc/slopos-i/AGENTS.md"
  install -Dm644 TRUTH.md "$pkgdir/usr/share/doc/slopos-i/TRUTH.md"
  install -Dm644 THIRD_PARTY_LICENSES.txt "$pkgdir/usr/share/doc/slopos-i/THIRD_PARTY_LICENSES.txt"
}
