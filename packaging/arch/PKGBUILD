# Maintainer: SLOPOS-I Contributors
pkgname=slopos-i
pkgver=0.1.0
pkgrel=1
pkgdesc="SLOPOS-I: a classic-Mac-styled Linux desktop environment in Rust"
arch=('x86_64' 'aarch64')
url="https://github.com/palaashatri/rust-slopos"
license=('MIT')
depends=(
  wayland
  wayland-protocols
  libxkbcommon
  libinput
  seatd
  libdrm
  mesa
  vulkan-icd-loader
  vulkan-swrast
  vulkan-tools
  libdisplay-info
  pixman
  dbus
  at-spi2-core
  fontconfig
  freetype2
  ttf-dejavu
  ttf-liberation
  pipewire
  pipewire-pulse
  wireplumber
  polkit
  xorg-xwayland
  foot
  wl-clipboard
  curl
)
makedepends=(
  cargo
  pkgconf
  rust
)
optdepends=(
  'greetd: for session greeter'
  'tuigreet: TUI greeter for greetd'
)
provides=('slopos-i')
conflicts=('slopos-i')

# Until a signed release tag is published, pin the source archive to the exact
# audited main commit instead of following a mutable branch or skipping the
# checksum.  Update both values as part of the release process.
_commit=8d3d3a8da0364e22c4562f568a292bf6a9e502d7
_source_dir="rust-slopos-${_commit}"
source=("$pkgname-$pkgver.tar.gz::https://github.com/palaashatri/rust-slopos/archive/${_commit}.tar.gz")
sha256sums=('0f4a6b0ad408977039dcd78f2d15df675d70b2aeafc29e94e216b06a1a3aa882')

build() {
  cd "$srcdir/$_source_dir"
  export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$srcdir/.cargo-target}"
  cargo build --release --workspace --locked
}

package() {
  cd "$srcdir/$_source_dir"
  export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$srcdir/.cargo-target}"

  # Install binaries
  install -Dm755 "$CARGO_TARGET_DIR/release/slopos-session" "$pkgdir/usr/bin/slopos-session"
  install -Dm755 "$CARGO_TARGET_DIR/release/slopos-compositor" "$pkgdir/usr/bin/slopos-compositor"
  install -Dm755 "$CARGO_TARGET_DIR/release/slopos-shell" "$pkgdir/usr/bin/slopos-shell"
  install -Dm755 "$CARGO_TARGET_DIR/release/finder" "$pkgdir/usr/bin/finder"
  install -Dm755 "$CARGO_TARGET_DIR/release/settings" "$pkgdir/usr/bin/settings"
  install -Dm755 "$CARGO_TARGET_DIR/release/textedit" "$pkgdir/usr/bin/textedit"
  install -Dm755 "$CARGO_TARGET_DIR/release/terminal" "$pkgdir/usr/bin/terminal"
  install -Dm755 "$CARGO_TARGET_DIR/release/appstore" "$pkgdir/usr/bin/appstore"
  install -Dm755 scripts/start-slopos-i "$pkgdir/usr/bin/start-slopos-i"

  # Install session files
  install -Dm644 packaging/slopos-i.desktop "$pkgdir/usr/share/xsessions/slopos-i.desktop"
  install -Dm644 packaging/slopos-i-wayland.desktop "$pkgdir/usr/share/wayland-sessions/slopos-i.desktop"
  install -Dm644 packaging/slopos-i.service "$pkgdir/usr/lib/systemd/user/slopos-i.service"

  # Install the three canonical project documents and legal notices.
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 AGENTS.md "$pkgdir/usr/share/doc/$pkgname/AGENTS.md"
  install -Dm644 TRUTH.md "$pkgdir/usr/share/doc/$pkgname/TRUTH.md"
  install -Dm644 THIRD_PARTY_LICENSES.txt "$pkgdir/usr/share/doc/$pkgname/THIRD_PARTY_LICENSES.txt"
}
