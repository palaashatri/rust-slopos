---
# Calamares branding for SLOPOS-I. Calamares 3.3 reads this from
# /usr/share/calamares/branding/slopos/ (copied there by live-installer.sh).
componentName:  slopos
welcomeStyleCalamares:   false
welcomeExpandingLogo:   false
windowExpanding:    normal
windowSize: 800px,520px
windowPlacement: center
sidebar: widget
navigation: widget
strings:
    productName:         "SLOPOS-I"
    shortProductName:    "SLOPOS-I"
    version:             "X11 alpha"
    shortVersion:        "alpha"
    versionedName:       "SLOPOS-I X11 alpha"
    shortVersionedName:  "SLOPOS-I alpha"
    bootloaderEntryName: "SLOPOS-I"
    productUrl:          ""
    supportUrl:          ""
    knownIssuesUrl:      ""
    releaseNotesUrl:     ""
    donateUrl:           ""
images:
    productIcon:         "logo.svg"
    productLogo:         "logo.svg"
    productWelcome:      "welcome.svg"
style:
   SidebarBackground:        "#1d1f22"
   SidebarText:              "#ffffff"
   SidebarTextCurrent:       "#1d1f22"
   SidebarBackgroundCurrent: "#e6e6e6"
slideshow:               "show.qml"
slideshowAPI: 2
uploadServer:
    type:    "none"
    url:     ""
    sizeLimit: -1
