// SLOPOS-I live session only. The live user may run the installer as root
// without a password prompt, and nothing else is granted. The live session
// has no polkit authentication agent, so this rule is what lets the
// "Install SLOPOS-I" launcher (pkexec /usr/bin/calamares) start. The installed
// system must not keep it: strip-live-system.sh removes this file.
polkit.addRule(function (action, subject) {
    if (action.id == "org.freedesktop.policykit.exec" &&
        action.lookup("program") == "/usr/bin/calamares" &&
        subject.user == "slopos" &&
        subject.local && subject.active) {
        return polkit.Result.YES;
    }
});
