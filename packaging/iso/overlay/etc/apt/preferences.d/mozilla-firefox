# Prefer Mozilla's Firefox over Ubuntu's firefox, which is a transitional
# package that installs the Snap build.
Package: *
Pin: origin packages.mozilla.org
Pin-Priority: 1000

# Block Ubuntu's snap-wrapper packages. Ubuntu's firefox and chromium-browser
# packages only install Snap builds; SLOPOS does not ship either.
Package: firefox*
Pin: release o=Ubuntu
Pin-Priority: -1

Package: chromium-browser*
Pin: release o=Ubuntu
Pin-Priority: -1
