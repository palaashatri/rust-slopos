# Additional packages layered onto Arch Linux's official releng archiso profile.
# Base/boot packages come from /usr/share/archiso/configs/releng.

# X11 desktop
xorg-server
xorg-xinit
xorg-xrandr
xorg-xsetroot
openbox
gtk3
dbus
xdotool
wmctrl

# Display manager for the live image
lightdm
lightdm-gtk-greeter

# SLOPOS default applications
pcmanfm
xfce4-terminal
mousepad
ristretto
zathura
zathura-pdf-mupdf
mpv
galculator
firefox

# System integration
networkmanager
network-manager-applet
pavucontrol
pipewire
pipewire-pulse
wireplumber
blueman
upower
xfce4-power-manager
lxappearance
arandr
polkit

# Visual/runtime assets
ttf-liberation
ttf-dejavu
adwaita-icon-theme

# QA / recovery helpers
scrot
imagemagick
curl
