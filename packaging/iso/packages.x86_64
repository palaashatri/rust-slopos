# Additional packages layered onto Arch Linux's official releng archiso profile.
# Base/boot packages come from /usr/share/archiso/configs/releng.

# X11 desktop
xorg-server
xorg-xinit
xorg-xrandr
xorg-xsetroot
openbox
gtk3
dbus
xdotool
wmctrl

# Display manager for the live image
lightdm
lightdm-gtk-greeter

# SLOPOS default applications
xfce4-terminal
mousepad
zathura
zathura-pdf-mupdf
firefox
supertux

# System integration and Settings delegates
networkmanager
pipewire
pipewire-pulse
wireplumber
upower
bluez
xfce4-power-manager
polkit

# Visual/runtime assets
ttf-liberation
ttf-dejavu
adwaita-icon-theme
librsvg

# QA / recovery helpers
scrot
imagemagick
curl
