{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SLOPOS Classic source inventory",
  "type": "object",
  "required": ["schema_version", "source", "status", "components"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "status": {"const": "PARTIAL_EXTRACTION_NOT_CONFORMANCE"},
    "source": {
      "type": "object",
      "required": ["file_key", "root_node", "retrieved_utc", "method", "file_revision", "canonical_scale", "source_fonts", "font_redistribution"],
      "additionalProperties": false,
      "properties": {
        "file_key": {"const": "LGMlwNCoVdakZxDBvPKg1W"},
        "root_node": {"const": "0:1"},
        "retrieved_utc": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "file_revision": {"type": "string", "minLength": 1},
        "canonical_scale": {"const": 1},
        "source_fonts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "font_redistribution": {"type": "string", "minLength": 1}
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_node", "source_component", "variant", "classification", "width", "height", "source_geometry_status", "detail_status", "interaction_status", "accessibility_status", "asset_policy"],
        "additionalProperties": false,
        "properties": {
          "source_node": {"type": "string", "pattern": "^[0-9]+:[0-9]+$"},
          "source_component": {"type": "string", "minLength": 1},
          "variant": {"type": "string", "minLength": 1},
          "classification": {"enum": ["REQUIRED", "OPTIONAL_VARIANT", "NOT_USED"]},
          "reason": {"type": "string", "minLength": 1},
          "width": {"type": "number", "minimum": 0},
          "height": {"type": "number", "minimum": 0},
          "source_geometry_status": {"const": "EXTRACTED_METADATA"},
          "detail_status": {"enum": ["UNKNOWN", "EXTRACTED"]},
          "interaction_status": {"enum": ["UNKNOWN", "SPECIFIED"]},
          "accessibility_status": {"enum": ["UNKNOWN", "SPECIFIED"]},
          "asset_policy": {"const": "GEOMETRY_ONLY_UNTIL_LICENSE_REVIEW"}
        },
        "if": {"properties": {"classification": {"const": "NOT_USED"}}},
        "then": {"required": ["reason"]}
      }
    }
  }
}
