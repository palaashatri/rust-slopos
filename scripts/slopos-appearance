#!/usr/bin/env bash
# Switch SLOPOS-I between its supported appearances.
set -euo pipefail

usage() {
  echo "Usage: slopos-appearance {classic|platinum|graphite|oled|status}" >&2
}

mode="${1:-status}"
case "$mode" in
  classic|platinum|graphite|oled|custom|status) ;;
  *) usage; exit 2 ;;
esac

config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
slopos_config="$config_home/slopos-i"
gtk_config="$config_home/gtk-3.0"
appearance_file="$slopos_config/appearance"

if [[ "$mode" == "status" ]]; then
  if [[ -r "$appearance_file" ]]; then
    value="$(tr -d '[:space:]' < "$appearance_file")"
    case "$value" in classic|platinum|graphite|oled|custom) echo "$value"; exit 0 ;; esac
  fi
  echo platinum
  exit 0
fi

mkdir -p "$slopos_config" "$gtk_config"
printf '%s\n' "$mode" > "$appearance_file.tmp"
mv -f "$appearance_file.tmp" "$appearance_file"

font_name="Liberation Sans 9"
if [[ -f "$slopos_config/font" ]]; then
  saved_font="$(tr -d '\r\n' < "$slopos_config/font")"
  if [[ -n "$saved_font" ]]; then
    font_name="$saved_font"
  fi
elif [[ -f "$gtk_config/settings.ini" ]]; then
  ini_font="$(grep -E '^gtk-font-name\s*=' "$gtk_config/settings.ini" | head -n1 | cut -d= -f2- | sed 's/^[[:space:]]*//')"
  if [[ -n "$ini_font" ]]; then
    font_name="$ini_font"
  fi
fi

if [[ "$mode" == "custom" ]]; then
  gtk_theme="slopos-gtk"
  css_name="custom-theme.css"
  rc_name="rc.xml"
  dark_pref=0
  root_color="#2B7798"
  if [[ -f "$slopos_config/root_color" ]]; then
    root_color="$(tr -d '\r\n' < "$slopos_config/root_color")"
  fi
elif [[ "$mode" == "oled" ]]; then
  gtk_theme="slopos-gtk-oled"
  css_name="gtk-oled.css"
  rc_name="rc-oled.xml"
  dark_pref=1
  root_color="#000000"
elif [[ "$mode" == "graphite" ]]; then
  gtk_theme="slopos-gtk-graphite"
  css_name="gtk-graphite.css"
  rc_name="rc-graphite.xml"
  dark_pref=1
  root_color="#25272B"
elif [[ "$mode" == "classic" ]]; then
  gtk_theme="slopos-gtk-classic"
  css_name="gtk-classic.css"
  rc_name="rc-classic.xml"
  dark_pref=0
  root_color="#808080"
else
  gtk_theme="slopos-gtk"
  css_name="gtk.css"
  rc_name="rc.xml"
  dark_pref=0
  root_color="#2B7798"
fi

cat > "$gtk_config/settings.ini.tmp" <<EOF
[Settings]
gtk-theme-name = $gtk_theme
gtk-icon-theme-name = SLOPOS-Platinum
gtk-cursor-theme-name = DMZ-White
gtk-font-name = $font_name
gtk-application-prefer-dark-theme = $dark_pref
gtk-shell-shows-menubar = 1
gtk-shell-shows-app-menu = 0
gtk-button-images = 1
gtk-menu-images = 1
gtk-xft-antialias = 1
gtk-xft-hinting = 1
gtk-xft-hintstyle = hintslight
gtk-xft-rgba = rgb
EOF
mv -f "$gtk_config/settings.ini.tmp" "$gtk_config/settings.ini"

cat > "$HOME/.gtkrc-2.0.tmp" <<EOF
# SLOPOS-I GTK2 Runtime Configuration
gtk-theme-name = "$gtk_theme"
gtk-icon-theme-name = "SLOPOS-Platinum"
gtk-font-name = "$font_name"
gtk-cursor-theme-name = "DMZ-White"
gtk-button-images = 1
gtk-menu-images = 1
gtk-toolbar-style = GTK_TOOLBAR_ICONS
EOF
mv -f "$HOME/.gtkrc-2.0.tmp" "$HOME/.gtkrc-2.0"

mkdir -p "$HOME/.icons/SLOPOS-Platinum" "$HOME/.local/share/icons/SLOPOS-Platinum"
for cand_icon in \
  "themes/platinum/icon-theme" \
  "/usr/local/share/icons/SLOPOS-Platinum" \
  "/usr/share/icons/SLOPOS-Platinum"; do
  if [[ -d "$cand_icon" ]]; then
    cp -a "$cand_icon"/. "$HOME/.icons/SLOPOS-Platinum/" 2>/dev/null || true
    cp -a "$cand_icon"/. "$HOME/.local/share/icons/SLOPOS-Platinum/" 2>/dev/null || true
    break
  fi
done

if [[ "$mode" == "custom" && -f "$slopos_config/custom-theme.css" ]]; then
  cp -f "$slopos_config/custom-theme.css" "$gtk_config/gtk.css"
  if [[ -f "$slopos_config/custom-theme.gtkrc" ]]; then
    mkdir -p "$HOME/.themes/slopos-gtk/gtk-2.0"
    cp -f "$slopos_config/custom-theme.gtkrc" "$HOME/.themes/slopos-gtk/gtk-2.0/gtkrc"
  fi
else
  for candidate_css in \
    "$HOME/.themes/$gtk_theme/gtk-3.0/gtk.css" \
    "/usr/local/share/themes/$gtk_theme/gtk-3.0/gtk.css" \
    "/usr/share/themes/$gtk_theme/gtk-3.0/gtk.css" \
    "assets/config/gtk-3.0/$css_name"; do
    if [[ -f "$candidate_css" ]]; then
      cp -f "$candidate_css" "$gtk_config/gtk.css"
      break
    fi
  done
fi

# Copy the entire Openbox theme directory, not just the themerc.  The parity
# theme ships original XBM title-button glyphs alongside its texture rules.
mkdir -p "$HOME/.themes"
for ob_theme in slopos-openbox slopos-openbox-classic slopos-openbox-graphite slopos-openbox-oled; do
  target="$HOME/.themes/$ob_theme/openbox-3"
  mkdir -p "$target"
  for cand_dir in \
    "themes/$ob_theme/openbox-3" \
    "/usr/local/share/themes/$ob_theme/openbox-3" \
    "/usr/share/themes/$ob_theme/openbox-3"; do
    if [[ -d "$cand_dir" && -f "$cand_dir/themerc" ]]; then
      cp -a "$cand_dir"/. "$target/" 2>/dev/null || true
      if mkdir -p "/usr/share/themes/$ob_theme/openbox-3" 2>/dev/null; then
        cp -a "$cand_dir"/. "/usr/share/themes/$ob_theme/openbox-3/" 2>/dev/null || true
      fi
      break
    fi
  done
done

for theme_spec in "slopos-gtk:themes/platinum:assets/config/gtk-3.0/gtk.css" \
                  "slopos-gtk-classic:themes/high-contrast:assets/config/gtk-3.0/gtk-classic.css" \
                  "slopos-gtk-graphite:themes/graphite:assets/config/gtk-3.0/gtk-graphite.css" \
                  "slopos-gtk-oled:themes/oled-graphite:assets/config/gtk-3.0/gtk-oled.css"; do
  th_name="$(echo "$theme_spec" | cut -d: -f1)"
  th_dir="$(echo "$theme_spec" | cut -d: -f2)"
  th_css="$(echo "$theme_spec" | cut -d: -f3)"
  mkdir -p "$HOME/.themes/$th_name/gtk-2.0" "$HOME/.themes/$th_name/gtk-3.0"
  if [[ -f "$th_dir/gtk-2.0/gtkrc" ]]; then
    cp -f "$th_dir/gtk-2.0/gtkrc" "$HOME/.themes/$th_name/gtk-2.0/gtkrc"
  elif [[ -f "/usr/share/themes/$th_name/gtk-2.0/gtkrc" ]]; then
    cp -f "/usr/share/themes/$th_name/gtk-2.0/gtkrc" "$HOME/.themes/$th_name/gtk-2.0/gtkrc"
  fi
  if [[ -f "$th_css" ]]; then
    cp -f "$th_css" "$HOME/.themes/$th_name/gtk-3.0/gtk.css"
  elif [[ -f "/usr/share/themes/$th_name/gtk-3.0/gtk.css" ]]; then
    cp -f "/usr/share/themes/$th_name/gtk-3.0/gtk.css" "$HOME/.themes/$th_name/gtk-3.0/gtk.css"
  fi
done

openbox_config="$config_home/openbox"
mkdir -p "$openbox_config"
for candidate_rc in \
  "/usr/local/share/slopos-i/openbox/$rc_name" \
  "/usr/share/slopos-i/openbox/$rc_name" \
  "assets/config/openbox/$rc_name"; do
  if [[ -f "$candidate_rc" ]]; then
    cp -f "$candidate_rc" "$openbox_config/rc.xml"
    break
  fi
done

# Give first-time Platinum sessions the blue desktop field used by the
# canonical parity composition, without replacing a wallpaper the user chose.
if [[ "$mode" == "platinum" && ! -s "$slopos_config/wallpaper" ]]; then
  for default_wallpaper in \
    "assets/wallpapers/03_slate_blue.png" \
    "/usr/local/share/slopos-i/wallpapers/03_slate_blue.png" \
    "/usr/share/slopos-i/wallpapers/03_slate_blue.png"; do
    if [[ -f "$default_wallpaper" ]]; then
      default_wallpaper="$(cd "$(dirname "$default_wallpaper")" && pwd)/$(basename "$default_wallpaper")"
      printf '%s\n' "$default_wallpaper" > "$slopos_config/wallpaper"
      printf 'fill\n' > "$slopos_config/wallpaper_mode"
      if command -v feh >/dev/null 2>&1 && [[ -n "${DISPLAY:-}" ]]; then
        feh --bg-fill "$default_wallpaper" >/dev/null 2>&1 || true
      fi
      break
    fi
  done
fi

if command -v xsetroot >/dev/null 2>&1 && [[ -n "${DISPLAY:-}" ]]; then
  xsetroot -solid "$root_color" >/dev/null 2>&1 || true
fi

if [[ "$mode" == "platinum" && -r "$slopos_config/wallpaper" && -n "${DISPLAY:-}" ]] && command -v feh >/dev/null 2>&1; then
  active_wallpaper="$(tr -d '\r\n' < "$slopos_config/wallpaper")"
  if [[ -f "$active_wallpaper" ]]; then
    feh --bg-fill "$active_wallpaper" >/dev/null 2>&1 || true
  fi
fi

if command -v openbox >/dev/null 2>&1 && [[ -n "${DISPLAY:-}" ]]; then
  openbox --reconfigure >/dev/null 2>&1 || true
fi

# Reload shell-owned surfaces after the theme changes.
pkill -TERM -x slopos-shell >/dev/null 2>&1 || true

if [[ "${XDG_CURRENT_DESKTOP:-}" == "SLOPOS" || "${SLOPOS_SESSION_MANAGED:-}" == "1" ]]; then
  pkill -TERM -x openbox >/dev/null 2>&1 || true
fi

printf 'SLOPOS appearance set to %s\n' "$mode"
