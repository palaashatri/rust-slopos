#!/usr/bin/env bash
# start-slopos-i — XDG launcher for the X11-only SLOPOS-I desktop.
set -euo pipefail

export XDG_SESSION_TYPE="x11"
export XDG_CURRENT_DESKTOP="SLOPOS-I"
export DESKTOP_SESSION="slopos-i"

if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
  export XDG_RUNTIME_DIR="/run/user/$(id -u)"
fi
mkdir -p "$XDG_RUNTIME_DIR"
chmod 700 "$XDG_RUNTIME_DIR" 2>/dev/null || true

# Make the installed SLOPOS GTK theme the default for applications launched in
# this session. Development checkouts can still rely on per-user GTK settings.
if [ -d /usr/local/share/themes/slopos-gtk/gtk-3.0 ] || [ -d /usr/share/themes/slopos-gtk/gtk-3.0 ]; then
  export GTK_THEME="slopos-gtk"
fi

if [ -z "${SLOPOS_OPENBOX_CONFIG:-}" ]; then
  for candidate in \
    /usr/local/share/slopos-i/openbox/rc.xml \
    /usr/share/slopos-i/openbox/rc.xml \
    "$(pwd)/assets/config/openbox/rc.xml"
  do
    if [ -f "$candidate" ]; then
      export SLOPOS_OPENBOX_CONFIG="$candidate"
      break
    fi
  done
fi

resolve_bin() {
  local name="$1"
  if command -v "$name" >/dev/null 2>&1; then
    command -v "$name"
    return 0
  fi
  local candidate
  for candidate in \
    "./target/release/$name" \
    "./target/debug/$name" \
    "$HOME/.local/bin/$name" \
    "/usr/local/bin/$name" \
    "/usr/bin/$name"
  do
    if [ -x "$candidate" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

SESSION_BIN="$(resolve_bin slopos-session)" || {
  echo "start-slopos-i: slopos-session binary not found" >&2
  exit 1
}

echo "Starting SLOPOS-I X11 desktop session..."
exec "$SESSION_BIN" "$@"
