#!/usr/bin/env bash
# start-slopos-i — XDG session launcher for SLOPOS-I X11 Desktop.
# Copyright (c) 2026 Palaash Atri
# SPDX-License-Identifier: MIT
set -euo pipefail

export XDG_SESSION_TYPE="x11"
export XDG_CURRENT_DESKTOP="SLOPOS-I"
export DESKTOP_SESSION="slopos-i"

if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
  export XDG_RUNTIME_DIR="/run/user/$(id -u)"
fi
mkdir -p "$XDG_RUNTIME_DIR"
chmod 700 "$XDG_RUNTIME_DIR" 2>/dev/null || true

resolve_bin() {
  local name="$1"
  if command -v "$name" >/dev/null 2>&1; then
    command -v "$name"
    return 0
  fi
  local here candidate
  here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  for candidate in \
    "./target/release/$name" \
    "./target/debug/$name" \
    "$HOME/.local/bin/$name" \
    "/usr/local/bin/$name" \
    "/usr/bin/$name"
  do
    if [ -x "$candidate" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

SESSION_BIN="$(resolve_bin slopos-session)" || {
  echo "start-slopos-i: slopos-session binary not found" >&2
  exit 1
}

echo "Starting SLOPOS-I X11 Desktop Session..."
exec "$SESSION_BIN" "$@"
