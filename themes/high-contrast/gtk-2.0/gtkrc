# SLOPOS-I Classic Contrast GTK2 Theme — monochrome appearance
gtk-color-scheme = "fg_color:#000000\nbg_color:#FFFFFF\nbase_color:#FFFFFF\ntext_color:#000000\nselected_bg_color:#000000\nselected_fg_color:#FFFFFF\ntooltip_bg_color:#FFFFFF\ntooltip_fg_color:#000000"

style "default" {
  xthickness = 2
  ythickness = 2

  GtkButton::default_border = { 0, 0, 0, 0 }
  GtkButton::default_outside_border = { 0, 0, 0, 0 }
  GtkButton::inner_border = { 2, 2, 1, 1 }
  GtkWidget::focus_padding = 0

  GtkTreeView::odd_row_color = "#FFFFFF"
  GtkTreeView::even_row_color = "#F0F0F0"
  GtkTreeView::row_ending_details = 0

  GtkMenu::horizontal_padding = 2
  GtkMenu::vertical_padding = 2

  fg[NORMAL]        = @fg_color
  fg[PRELIGHT]      = @fg_color
  fg[ACTIVE]        = @fg_color
  fg[SELECTED]      = @selected_fg_color
  fg[INSENSITIVE]   = "#777777"

  bg[NORMAL]        = @bg_color
  bg[PRELIGHT]      = "#000000"
  bg[ACTIVE]        = "#000000"
  bg[SELECTED]      = @selected_bg_color
  bg[INSENSITIVE]   = @bg_color

  base[NORMAL]      = @base_color
  base[PRELIGHT]    = @base_color
  base[ACTIVE]      = @selected_bg_color
  base[SELECTED]    = @selected_bg_color
  base[INSENSITIVE] = "#EEEEEE"

  text[NORMAL]      = @text_color
  text[PRELIGHT]    = @text_color
  text[ACTIVE]      = @selected_fg_color
  text[SELECTED]    = @selected_fg_color
  text[INSENSITIVE] = "#777777"
}

style "menu" {
  xthickness = 3
  ythickness = 3
  bg[NORMAL] = "#FFFFFF"
  bg[INSENSITIVE] = "#FFFFFF"
}

style "menu_item" {
  xthickness = 5
  ythickness = 3
  bg[PRELIGHT] = "#000000"
  fg[PRELIGHT] = "#FFFFFF"
  text[PRELIGHT] = "#FFFFFF"
}

style "button" {
  xthickness = 3
  ythickness = 3
  bg[NORMAL]   = "#FFFFFF"
  bg[PRELIGHT] = "#000000"
  fg[PRELIGHT] = "#FFFFFF"
  bg[ACTIVE]   = "#000000"
  fg[ACTIVE]   = "#FFFFFF"
}

style "toolbar" {
  xthickness = 2
  ythickness = 2
  bg[NORMAL] = "#FFFFFF"
}

style "treeview" {
  xthickness = 2
  ythickness = 2
  base[NORMAL] = "#FFFFFF"
  text[NORMAL] = "#000000"
  base[SELECTED] = "#000000"
  text[SELECTED] = "#FFFFFF"
}

style "entry" {
  xthickness = 2
  ythickness = 2
  base[NORMAL] = "#FFFFFF"
  text[NORMAL] = "#000000"
}

class "GtkWidget" style "default"
class "GtkMenu" style "menu"
class "GtkMenuItem" style "menu_item"
class "GtkItem" style "menu_item"
class "GtkButton" style "button"
class "GtkToolbar" style "toolbar"
class "GtkTreeView" style "treeview"
class "GtkIconView" style "treeview"
class "GtkEntry" style "entry"
widget_class "*<GtkMenu>*" style "menu"
widget_class "*<GtkMenuItem>*" style "menu_item"
