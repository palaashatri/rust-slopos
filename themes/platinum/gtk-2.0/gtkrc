# SLOPOS-I Platinum GTK2 Theme — Authentic System 7 / Platinum
gtk-color-scheme = "fg_color:#000000\nbg_color:#D9D9D9\nbase_color:#FFFFFF\ntext_color:#000000\nselected_bg_color:#8A92A0\nselected_fg_color:#FFFFFF\ntooltip_bg_color:#FFFFE1\ntooltip_fg_color:#000000"

style "default" {
  xthickness = 2
  ythickness = 2

  GtkButton::default_border = { 0, 0, 0, 0 }
  GtkButton::default_outside_border = { 0, 0, 0, 0 }
  GtkButton::inner_border = { 2, 2, 1, 1 }
  GtkWidget::focus_padding = 0

  GtkTreeView::odd_row_color = "#FFFFFF"
  GtkTreeView::even_row_color = "#F4F4F4"
  GtkTreeView::row_ending_details = 0
  GtkTreeView::expander_size = 12

  GtkMenu::horizontal_padding = 2
  GtkMenu::vertical_padding = 2

  fg[NORMAL]        = @fg_color
  fg[PRELIGHT]      = @fg_color
  fg[ACTIVE]        = @fg_color
  fg[SELECTED]      = @selected_fg_color
  fg[INSENSITIVE]   = "#808080"

  bg[NORMAL]        = @bg_color
  bg[PRELIGHT]      = "#E8E8E8"
  bg[ACTIVE]        = "#C0C0C0"
  bg[SELECTED]      = @selected_bg_color
  bg[INSENSITIVE]   = @bg_color

  base[NORMAL]      = @base_color
  base[PRELIGHT]    = @base_color
  base[ACTIVE]      = @selected_bg_color
  base[SELECTED]    = @selected_bg_color
  base[INSENSITIVE] = "#E8E8E8"

  text[NORMAL]      = @text_color
  text[PRELIGHT]    = @text_color
  text[ACTIVE]      = @selected_fg_color
  text[SELECTED]    = @selected_fg_color
  text[INSENSITIVE] = "#808080"
}

style "menu" {
  xthickness = 3
  ythickness = 3
  bg[NORMAL] = "#D9D9D9"
  bg[INSENSITIVE] = "#D9D9D9"
}

style "menu_item" {
  xthickness = 5
  ythickness = 3
  bg[PRELIGHT] = @selected_bg_color
  fg[PRELIGHT] = @selected_fg_color
  text[PRELIGHT] = @selected_fg_color
}

style "button" {
  xthickness = 3
  ythickness = 3
  bg[NORMAL]   = "#D9D9D9"
  bg[PRELIGHT] = "#E8E8E8"
  bg[ACTIVE]   = "#C0C0C0"
}

style "toolbar" {
  xthickness = 2
  ythickness = 2
  bg[NORMAL] = "#D9D9D9"
}

style "treeview" {
  xthickness = 2
  ythickness = 2
  base[NORMAL] = "#FFFFFF"
  text[NORMAL] = "#000000"
  base[SELECTED] = @selected_bg_color
  text[SELECTED] = @selected_fg_color
}

style "entry" {
  xthickness = 2
  ythickness = 2
  base[NORMAL] = "#FFFFFF"
  text[NORMAL] = "#000000"
}

class "GtkWidget" style "default"
class "GtkMenu" style "menu"
class "GtkMenuItem" style "menu_item"
class "GtkItem" style "menu_item"
class "GtkButton" style "button"
class "GtkToolbar" style "toolbar"
class "GtkTreeView" style "treeview"
class "GtkIconView" style "treeview"
class "GtkEntry" style "entry"
widget_class "*<GtkMenu>*" style "menu"
widget_class "*<GtkMenuItem>*" style "menu_item"
