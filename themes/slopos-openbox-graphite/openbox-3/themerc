window.active.grip.bg.color: #383C44
window.inactive.grip.bg: flat solid
window.inactive.grip.bg.color: #26282D
menu.border.color: #383B42
menu.border.width: 1
menu.title.bg: flat gradient vertical
menu.title.bg.color: #383C44
menu.title.bg.colorTo: #282B30
menu.title.text.color: #E8EAED
