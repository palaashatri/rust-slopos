window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #202226
window.inactive.label.bg: parentrelative
window.inactive.label.text.color: #7B8089
window.active.button.unpressed.bg: flat gradient vertical
window.active.button.unpressed.bg.color: #454952
window.active.button.unpressed.bg.colorTo: #2D3036
window.active.button.pressed.bg: flat gradient vertical
window.active.button.pressed.bg.color: #222428
window.active.button.pressed.bg.colorTo: #33363D
