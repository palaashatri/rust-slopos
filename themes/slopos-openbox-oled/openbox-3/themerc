# SLOPOS OLED Dark Openbox theme with Gray Borders
padding.width: 3
padding.height: 3
window.client.padding.width: 0
window.client.padding.height: 0
border.width: 1
border.color: #4A4D57
window.active.border.color: #4A4D57
window.inactive.border.color: #2A2C33
window.active.title.bg: flat gradient vertical
window.active.title.bg.color: #121316
window.active.title.bg.colorTo: #000000
window.active.label.bg: parentrelative
window.active.label.text.color: #FFFFFF
window.active.label.text.font: shadow=off
window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #050505
window.inactive.label.bg: parentrelative
window.inactive.label.text.color: #717680
window.active.button.unpressed.bg: raised solid
window.active.button.unpressed.bg.color: #18191E
window.active.button.pressed.bg: sunken solid
window.active.button.pressed.bg.color: #000000
window.active.button.unpressed.image.color: #FFFFFF
window.active.button.pressed.image.color: #FFFFFF
window.inactive.button.unpressed.bg: flat solid
window.inactive.button.unpressed.bg.color: #050505
window.inactive.button.unpressed.image.color: #555861
window.active.handle.bg: flat solid
window.active.handle.bg.color: #4A4D57
window.inactive.handle.bg: flat solid
window.inactive.handle.bg.color: #2A2C33
window.active.grip.bg: flat solid
window.active.grip.bg.color: #4A4D57
window.inactive.grip.bg: flat solid
window.inactive.grip.bg.color: #2A2C33
menu.border.color: #4A4D57
menu.border.width: 1
menu.title.bg: flat gradient vertical
menu.title.bg.color: #121316
menu.title.bg.colorTo: #000000
menu.title.text.color: #FFFFFF
menu.items.bg: flat solid
menu.items.bg.color: #000000
menu.items.text.color: #FFFFFF
menu.items.disabled.text.color: #717680
menu.items.active.bg: flat solid
menu.items.active.bg.color: #8A92A0
menu.items.active.text.color: #FFFFFF

# Soft shadow settings for OLED depth
window.active.shadow.color: #000000
window.active.shadow.opacity: 0.25
window.active.shadow.offset.x: 2
window.active.shadow.offset.y: 2
window.inactive.shadow.color: #000000
window.inactive.shadow.opacity: 0.12
window.inactive.shadow.offset.x: 1
window.inactive.shadow.offset.y: 1
menu.overlap.x: 0
menu.overlap.y: 0
menu.separator.width: 1
menu.separator.padding.width: 8
menu.separator.padding.height: 4
menu.items.padding.x: 8
menu.items.padding.y: 3
menu.title.padding.x: 6
menu.title.padding.y: 4
menu.title.text.justify: left
menu.window.active.button.unpressed.bg: flat gradient vertical
menu.window.active.button.unpressed.bg.color: #18191E
menu.window.active.button.unpressed.bg.colorTo: #000000
menu.window.active.button.unpressed.bg.border: 1 1 1 1
menu.window.active.button.pressed.bg: flat gradient vertical
menu.window.active.button.pressed.bg.color: #000000
menu.window.active.button.pressed.bg.colorTo: #18191E
menu.window.active.button.pressed.bg.border: 1 1 1 1
