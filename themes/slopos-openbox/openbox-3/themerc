# SLOPOS Platinum Openbox theme

padding.width: 4
padding.height: 3
window.client.padding.width: 0
window.client.padding.height: 0
border.width: 1
border.color: #5A6270
window.active.border.color: #5A6270
window.inactive.border.color: #B0B5BD

# Platinum active window title gradient
window.active.title.bg: flat gradient vertical
window.active.title.bg.color: #F4F5F7
window.active.title.bg.colorTo: #D8DCE3
window.active.label.bg: parentrelative
window.active.label.text.color: #1A1D20
window.active.label.text.font: shadow=off

window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #E2E5EB
window.inactive.label.bg: parentrelative
window.inactive.label.text.color: #7A808C

window.active.button.unpressed.bg: flat gradient vertical
window.active.button.unpressed.bg.color: #FFFFFF
window.active.button.unpressed.bg.colorTo: #D0D5DD
window.active.button.pressed.bg: flat gradient vertical
window.active.button.pressed.bg.color: #B8BCC6
window.active.button.pressed.bg.colorTo: #D0D5DD
window.active.button.unpressed.image.color: #2D3139
window.active.button.pressed.image.color: #1A1D20
window.inactive.button.unpressed.bg: flat solid
window.inactive.button.unpressed.bg.color: #E2E5EB
window.inactive.button.unpressed.image.color: #8C93A0

menu.border.color: #5A6270
menu.border.width: 1
menu.title.bg: flat gradient vertical
menu.title.bg.color: #F4F5F7
menu.title.bg.colorTo: #D8DCE3
menu.title.text.color: #1A1D20
menu.items.bg: flat solid
menu.items.bg.color: #FFFFFF
menu.items.text.color: #1A1D20
menu.items.disabled.text.color: #7A808C
menu.items.active.bg: flat solid
menu.items.active.bg.color: #3B71CA
menu.items.active.text.color: #FFFFFF

