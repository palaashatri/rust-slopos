# SLOPOS Platinum Openbox theme

padding.width: 3
padding.height: 3
border.width: 1
window.active.border.color: #000000
window.inactive.border.color: #808080

# Keep the active frame's Platinum bevel, but use a smooth gradient so title
# text remains legible at 1x and HiDPI instead of competing with dense stripes.
window.active.title.bg: raised gradient vertical
window.active.title.bg.color: #F0F0F0
window.active.title.bg.colorTo: #CFCFCF
window.active.label.bg: parentrelative
window.active.label.text.color: #000000
window.active.label.text.font: shadow=off

window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #C8C8C8
window.inactive.label.bg: parentrelative
window.inactive.label.text.color: #707070

window.active.button.unpressed.bg: raised solid
window.active.button.unpressed.bg.color: #D9D9D9
window.active.button.pressed.bg: sunken solid
window.active.button.pressed.bg.color: #A8A8A8
window.active.button.unpressed.image.color: #000000
window.active.button.pressed.image.color: #000000
window.inactive.button.unpressed.bg: flat solid
window.inactive.button.unpressed.bg.color: #C8C8C8
window.inactive.button.unpressed.image.color: #777777

menu.border.color: #000000
menu.border.width: 2
# Keep menu headers on the same legible Platinum gradient as active frames;
# interlaced fills turn compact labels into noisy black/white stripes at 1x.
menu.title.bg: raised gradient vertical
menu.title.bg.color: #F0F0F0
menu.title.bg.colorTo: #D0D0D0
menu.title.text.color: #000000
menu.items.bg: flat solid
menu.items.bg.color: #FFFFFF
menu.items.text.color: #000000
menu.items.disabled.text.color: #888888
menu.items.active.bg: flat solid
menu.items.active.bg.color: #000080
menu.items.active.text.color: #FFFFFF
