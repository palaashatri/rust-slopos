# SLOPOS Platinum Openbox theme

padding.width: 3
padding.height: 3
border.width: 1
window.active.border.color: #000000
window.inactive.border.color: #808080

# Keep the active frame's Platinum bevel, but use a smooth gradient so title
# text remains legible at 1x and HiDPI instead of competing with dense stripes.
# Keep the title fill flat so Openbox does not draw the raised-bevel scanline
# pattern that turns active upstream windows into black/white stripes at 1x.
# The Platinum bevel is supplied by the one-pixel frame border and buttons;
# title text needs a clean gradient for legibility across Xvfb and real X11.
window.active.title.bg: flat gradient vertical
window.active.title.bg.color: #F0F0F0
window.active.title.bg.colorTo: #CFCFCF
window.active.label.bg: parentrelative
window.active.label.text.color: #000000
window.active.label.text.font: shadow=off

window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #C8C8C8
window.inactive.label.bg: parentrelative
window.inactive.label.text.color: #707070

window.active.button.unpressed.bg: raised solid
window.active.button.unpressed.bg.color: #D9D9D9
window.active.button.pressed.bg: sunken solid
window.active.button.pressed.bg.color: #A8A8A8
window.active.button.unpressed.image.color: #000000
window.active.button.pressed.image.color: #000000
window.inactive.button.unpressed.bg: flat solid
window.inactive.button.unpressed.bg.color: #C8C8C8
window.inactive.button.unpressed.image.color: #777777

menu.border.color: #C0C0C0
menu.border.width: 1
# Keep menu headers on the same legible Platinum gradient as active frames;
# interlaced fills turn compact labels into noisy black/white stripes at 1x.
menu.title.bg: flat gradient vertical
menu.title.bg.color: #F0F0F0
menu.title.bg.colorTo: #D0D0D0
menu.title.text.color: #000000
menu.items.bg: flat solid
menu.items.bg.color: #FFFFFF
menu.items.text.color: #000000
# Match the Platinum GTK disabled-text token on white menus (the prior
# #888888 was too low-contrast for compact 9px labels).
menu.items.disabled.text.color: #5E5E5E
menu.items.active.bg: flat solid
menu.items.active.bg.color: #8A92A0
menu.items.active.text.color: #FFFFFF

# Soft shadow settings for Platinum depth
window.active.shadow.color: #000000
window.active.shadow.opacity: 0.15
window.active.shadow.offset.x: 2
window.active.shadow.offset.y: 2
window.inactive.shadow.color: #000000
window.inactive.shadow.opacity: 0.08
window.inactive.shadow.offset.x: 1
window.inactive.shadow.offset.y: 1
menu.overlap.x: 0
menu.overlap.y: 0
# Soft diffused shadows for menus - matches Platinum surface depth
menu.shadow.color: #000000
menu.shadow.opacity: 0.12
menu.shadow.offset.x: 2
menu.shadow.offset.y: 3
menu.shadow.radius: 8
menu.separator.width: 1
menu.separator.padding.width: 8
menu.separator.padding.height: 4
menu.items.padding.x: 8
menu.items.padding.y: 3
menu.title.padding.x: 6
menu.title.padding.y: 4
menu.title.text.justify: left
menu.window.active.button.unpressed.bg: raised gradient vertical
menu.window.active.button.unpressed.bg.color: #D9D9D9
menu.window.active.button.unpressed.bg.colorTo: #C0C0C0
menu.window.active.button.unpressed.bg.border: 1 1 1 1
menu.window.active.button.pressed.bg: sunken gradient vertical
menu.window.active.button.pressed.bg.color: #A0A0A0
menu.window.active.button.pressed.bg.colorTo: #B0B0B0
menu.window.active.button.pressed.bg.border: 1 1 1 1
