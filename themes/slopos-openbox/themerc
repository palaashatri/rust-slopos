# SLOPOS System 7 / Platinum Openbox Window Theme

# Window Layout & Padding
padding.width: 3
padding.height: 3
border.width: 1
window.active.border.color: #000000
window.inactive.border.color: #A0A0A0

# Active Window Titlebar (Classic Platinum Gradient)
window.active.title.bg: flat gradient vertical
window.active.title.bg.color: #E6E6E6
window.active.title.bg.colorTo: #CDCDCD
window.active.label.bg: parentrelative
window.active.label.text.color: #000000
window.active.label.text.font: shadow=off

# Inactive Window Titlebar (Flat Gray)
window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #D6D6D6
window.inactive.label.bg: parentrelative
window.inactive.label.text.color: #707070

# Titlebar Buttons (Classic System 7 Close & Zoom Boxes)
window.active.button.unpressed.image.color: #000000
window.active.button.pressed.image.color: #FFFFFF
window.inactive.button.unpressed.image.color: #808080

window.active.button.close.unpressed.bg: flat solid
window.active.button.close.unpressed.bg.color: #E0E0E0
window.active.button.max.unpressed.bg: flat solid
window.active.button.max.unpressed.bg.color: #E0E0E0

# Menu & Client Borders
menu.border.color: #000000
menu.border.width: 2
menu.items.bg: flat solid
menu.items.bg.color: #FFFFFF
menu.items.text.color: #000000
menu.items.active.bg: flat solid
menu.items.active.bg.color: #000080
menu.items.active.text.color: #FFFFFF
